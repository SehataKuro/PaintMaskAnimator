<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  tauri build が作る Info.plist に足す分（0.8.0 の packaging/PaintMaskAnimator.spec と同じ）。
  .pman をダブルクリックで開く。中身は zip だが、zip として展開されないよう
  public.data にだけ準ずる独自の種類にする。
-->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>PaintMaskAnimator</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.sehatakuro.paintmaskanimator.project</string>
			<key>UTTypeDescription</key>
			<string>PaintMaskAnimator Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pman</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PaintMaskAnimator Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.sehatakuro.paintmaskanimator.project</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
